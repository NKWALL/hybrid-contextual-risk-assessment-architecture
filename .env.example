GOOGLE_API_KEY=your_google_api_key_here
MODEL_NAME=your_model_name_here
APP_ENV=your_app_env_here

# Appwrite connection
APPWRITE_ENDPOINT=your_appwrite_endpoint_here
APPWRITE_PROJECT_ID=your_appwrite_project_id_here
APPWRITE_API_KEY=your_appwrite_api_key_here
APPWRITE_DB_ID=your_appwrite_db_id_here

# MySQL knowledge base
MYSQL_HOST=your_mysql_host_here
MYSQL_USER=your_mysql_user_here
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=your_mysql_database_here

# OpenAI moderation guardrail
OPENAI_API_KEY=your_openai_api_key_here

# === LLM Provider Switching (Optional) ===
# Leave blank to use defaults (gemini + openai_moderation)

# NLP (risk_analysis_v2)
NLP_PROVIDER=your_nlp_provider_here
# Required when NLP_PROVIDER=openai_compat
NLP_OPENAI_BASE_URL=your_nlp_openai_base_url_here
NLP_OPENAI_API_KEY=your_nlp_openai_api_key_here
NLP_MODEL=your_nlp_model_here

# Summary (memory_summary_v1) - empty values reuse NLP_* settings
SUMMARY_PROVIDER=your_summary_provider_here
SUMMARY_OPENAI_BASE_URL=your_summary_openai_base_url_here
SUMMARY_OPENAI_API_KEY=your_summary_openai_api_key_here
SUMMARY_MODEL=your_summary_model_here

# Guardrail
GUARDRAIL_PROVIDER=your_guardrail_provider_here
# Required when GUARDRAIL_PROVIDER=llm_classifier
GUARDRAIL_BASE_URL=your_guardrail_base_url_here
GUARDRAIL_API_KEY=your_guardrail_api_key_here
GUARDRAIL_MODEL=your_guardrail_model_here
# 已實測可行的 GUARDRAIL_MODEL 值（依 BASE_URL 而異）：
#   本機 Ollama（推薦，BASE_URL=http://localhost:11434/v1, API_KEY=ollama）：
#     llama-guard3:1b   (~1GB / warm 0.14s / 中文 domain-specific 威脅 coverage 不完整)
#     llama-guard3:8b   (~5GB / warm 0.25s / 稍微準一點但仍有中文限制)
#   Groq（BASE_URL=https://api.groq.com/openai/v1, 雲端）：
#     meta-llama/llama-guard-4-12b
#   OpenAI Moderation 不在這欄填，改用 GUARDRAIL_PROVIDER=openai_moderation 跟 OPENAI_API_KEY

# Background context judge for repeated/semantic Step 0 flags (optional)
# Default false keeps current behavior unchanged.
BACKGROUND_JUDGE_ENABLED=your_background_judge_enabled_here
BACKGROUND_JUDGE_BASE_URL=your_background_judge_base_url_here
BACKGROUND_JUDGE_API_KEY=your_background_judge_api_key_here
BACKGROUND_JUDGE_MODEL=your_background_judge_model_here
